  <diagram id="page_rbac" name="4 - RBAC Approach">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
<mxCell id="rb_entra" value="Microsoft Entra ID
App Registration + App Roles
(or dev header in the exercise)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="220" height="60" as="geometry"/></mxCell>
<mxCell id="rb_req" value="Incoming API request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="40" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="rb_authn" value="AuthN middleware
identity (UserId) + coarse Role
(Entra App Role / JWT 'roles' claim)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="40" width="220" height="60" as="geometry"/></mxCell>
<mxCell id="rb_note2" value="Entra ID: API's App Registration exposes App Roles CountryEditor/CountryReviewer (scope, admin consent, App ID URI). Each consuming client (portal, service) has its own separate App Registration + Client ID. Security Groups map to the App Roles for provisioning. Coarse gate only - see rb_store below and ARCHITECTURE.md §6.3." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="115" width="760" height="35" as="geometry"/></mxCell>
<mxCell id="rb_handler" value="Resource-based AuthZ Handler
(IAuthorizationHandler)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="160" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="rb_store" value="UserCountryRole store - authoritative
